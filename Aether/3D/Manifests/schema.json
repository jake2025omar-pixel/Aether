{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Aether 3D Asset Inspection Schema",
  "description": "Standardized schema for forensic inspection manifests of 3D asset archives in Aether.",
  "type": "object",
  "definitions": {
    "ConfidenceLevel": {
      "type": "string",
      "enum": ["DETECTED", "INFERRED", "NOT_DETERMINED", "UNCONFIRMED"]
    },
    "ProcessingStatus": {
      "type": "string",
      "enum": ["DISCOVERED", "IN_PROGRESS", "COMPLETED", "FAILED"]
    },
    "InspectionStatus": {
      "type": "string",
      "enum": ["NOT_INSPECTED", "INSPECTED", "FAILED"]
    },
    "AssetCategory": {
      "type": "string",
      "enum": [
        "CHARACTER",
        "ROOM",
        "ENVIRONMENT",
        "FURNITURE",
        "OUTFIT",
        "CLOTHING",
        "HAIR",
        "FACE",
        "ACCESSORY",
        "PROP",
        "ANIMATION",
        "MOTION",
        "MUSIC",
        "AUDIO",
        "TEXTURE",
        "MATERIAL",
        "SHADER",
        "MODEL",
        "RIG",
        "SKELETON",
        "MORPH",
        "BLENDSHAPE",
        "CONFIG",
        "METADATA",
        "IMAGE",
        "VIDEO",
        "UNKNOWN",
        "NOT_DETERMINED"
      ]
    },
    "ArchiveInventoryItem": {
      "type": "object",
      "required": [
        "archive_id",
        "original_filename",
        "sha256",
        "size_bytes",
        "format",
        "location",
        "status",
        "inspection_status"
      ],
      "properties": {
        "archive_id": { "type": "string", "pattern": "^(arch_[a-f0-9]{12}|archive_[0-9]{3,})$" },
        "alias_id": { "type": "string" },
        "original_filename": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "format": { "type": "string" },
        "location": { "type": "string" },
        "status": { "$ref": "#/definitions/ProcessingStatus" },
        "inspection_status": { "$ref": "#/definitions/InspectionStatus" },
        "discovered_at": { "type": "string", "format": "date-time" },
        "last_inspected_at": { "type": ["string", "null"] },
        "error_message": { "type": ["string", "null"] }
      }
    },
    "ArchiveFileEntry": {
      "type": "object",
      "required": [
        "internal_path",
        "file_name",
        "extension",
        "size_bytes",
        "compressed_size_bytes",
        "is_directory",
        "is_nested_archive",
        "is_suspicious_or_corrupt"
      ],
      "properties": {
        "internal_path": { "type": "string" },
        "file_name": { "type": "string" },
        "extension": { "type": "string" },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "compressed_size_bytes": { "type": "integer", "minimum": 0 },
        "crc32": { "type": "string" },
        "sha256": { "type": "string" },
        "is_directory": { "type": "boolean" },
        "is_nested_archive": { "type": "boolean" },
        "is_suspicious_or_corrupt": { "type": "boolean" },
        "corruption_notes": { "type": ["string", "null"] },
        "compression_method": { "type": "string" }
      }
    },
    "ArchiveManifest": {
      "type": "object",
      "required": [
        "archive_id",
        "original_filename",
        "sha256",
        "size_bytes",
        "format",
        "inspected_at",
        "inspection_status",
        "file_count",
        "files",
        "folders",
        "warnings"
      ],
      "properties": {
        "archive_id": { "type": "string" },
        "alias_id": { "type": "string" },
        "original_filename": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "format": { "type": "string" },
        "location": { "type": "string" },
        "inspected_at": { "type": "string", "format": "date-time" },
        "inspection_status": { "type": "string", "enum": ["COMPLETED", "FAILED"] },
        "error_reason": { "type": ["string", "null"] },
        "file_count": { "type": "integer", "minimum": 0 },
        "folder_count": { "type": "integer", "minimum": 0 },
        "uncompressed_total_bytes": { "type": "integer", "minimum": 0 },
        "folders": {
          "type": "array",
          "items": { "type": "string" }
        },
        "files": {
          "type": "array",
          "items": { "$ref": "#/definitions/ArchiveFileEntry" }
        },
        "detected_3d_assets_count": { "type": "integer", "minimum": 0 },
        "nested_archives": {
          "type": "array",
          "items": { "type": "string" }
        },
        "dependencies_detected": {
          "type": "array",
          "items": { "type": "string" }
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "AssetTechnical3D": {
      "type": "object",
      "properties": {
        "format": { "type": "string" },
        "mesh_count": { "type": ["integer", "string"] },
        "vertex_count": { "type": ["integer", "string"] },
        "triangle_count": { "type": ["integer", "string"] },
        "material_count": { "type": ["integer", "string"] },
        "texture_count": { "type": ["integer", "string"] },
        "texture_dimensions": { "type": ["object", "string"] },
        "texture_formats": { "type": ["array", "string"] },
        "skeleton": { "type": ["boolean", "string"] },
        "bone_count": { "type": ["integer", "string"] },
        "bone_names": { "type": ["array", "string"] },
        "animation_count": { "type": ["integer", "string"] },
        "animation_names": { "type": ["array", "string"] },
        "animation_duration": { "type": ["number", "string"] },
        "blend_shapes": { "type": ["array", "string"] },
        "facial_morphs": { "type": ["array", "string"] },
        "uv_channels": { "type": ["integer", "string"] },
        "normal_information": { "type": ["boolean", "string"] },
        "tangent_information": { "type": ["boolean", "string"] },
        "embedded_textures": { "type": ["boolean", "string"] },
        "external_textures": { "type": ["array", "string"] },
        "external_dependencies": { "type": ["array", "string"] },
        "missing_dependencies": { "type": ["array", "string"] },
        "coordinate_system": { "type": "string" },
        "scale_information": { "type": ["number", "string"] },
        "import_warnings": { "type": "array", "items": { "type": "string" } },
        "compatibility_warnings": { "type": "array", "items": { "type": "string" } },
        "deep_analysis": { "type": "string", "enum": ["COMPLETED", "PARTIAL", "NOT_DETERMINED"] }
      }
    },
    "AssetManifest": {
      "type": "object",
      "required": [
        "asset_id",
        "archive_id",
        "original_archive",
        "internal_path",
        "file_name",
        "category",
        "category_confidence",
        "dependencies",
        "relationships",
        "warnings"
      ],
      "properties": {
        "asset_id": { "type": "string" },
        "archive_id": { "type": "string" },
        "original_archive": { "type": "string" },
        "internal_path": { "type": "string" },
        "file_name": { "type": "string" },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "category": { "$ref": "#/definitions/AssetCategory" },
        "category_confidence": { "$ref": "#/definitions/ConfidenceLevel" },
        "semantic_name": { "type": "string" },
        "semantic_description": { "type": "string" },
        "technical_3d": { "$ref": "#/definitions/AssetTechnical3D" },
        "dependencies": {
          "type": "array",
          "items": { "type": "string" }
        },
        "relationships": {
          "type": "object",
          "properties": {
            "character_for": { "type": ["string", "null"] },
            "outfit_for": { "type": ["string", "null"] },
            "hair_for": { "type": ["string", "null"] },
            "accessory_for": { "type": ["string", "null"] },
            "textures": { "type": "array", "items": { "type": "string" } },
            "materials": { "type": "array", "items": { "type": "string" } },
            "skeleton": { "type": ["string", "null"] },
            "animations": { "type": "array", "items": { "type": "string" } },
            "possible_duplicate_of": { "type": ["string", "null"] },
            "possible_variant_of": { "type": ["string", "null"] }
          }
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "MasterIndex": {
      "type": "object",
      "required": [
        "generated_at",
        "total_archives",
        "total_assets",
        "archives",
        "assets"
      ],
      "properties": {
        "generated_at": { "type": "string", "format": "date-time" },
        "schema_version": { "type": "string" },
        "total_archives": { "type": "integer", "minimum": 0 },
        "total_assets": { "type": "integer", "minimum": 0 },
        "categories_summary": { "type": "object" },
        "archives": { "type": "object" },
        "assets": { "type": "object" }
      }
    }
  }
}

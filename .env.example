# ==============================================================================
# SERVER-ONLY CONFIGURATION
# Secrets and backend parameters. Never expose these to the client-side bundle.
# ==============================================================================

# Required for server-side Gemini API calls.
# Injected at runtime from user secrets / environment.
GEMINI_API_KEY=""

# Server listening port (defaults to 3000 in development / container environment)
PORT=3000

# ==============================================================================
# CLIENT-SAFE / HOSTING CONFIGURATION
# Safe environment parameters for hosting and endpoints.
# ==============================================================================

# Public URL where the application is hosted.
APP_URL=""

# ==============================================================================
# VITE CLIENT-SIDE CONFIGURATION — FIREBASE AUTHENTICATION
# Client-safe configuration for Firebase Google Authentication.
# These values are safe to bundle into the frontend application.
# ==============================================================================

# Firebase Web API Key
VITE_FIREBASE_API_KEY=""

# Firebase Auth Domain (e.g., your-project-id.firebaseapp.com)
VITE_FIREBASE_AUTH_DOMAIN=""

# Firebase Project ID
VITE_FIREBASE_PROJECT_ID=""

# Firebase Storage Bucket (e.g., your-project-id.appspot.com)
VITE_FIREBASE_STORAGE_BUCKET=""

# Firebase Cloud Messaging Sender ID
VITE_FIREBASE_MESSAGING_SENDER_ID=""

# Firebase Web App ID
VITE_FIREBASE_APP_ID=""



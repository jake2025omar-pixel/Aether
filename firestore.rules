rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // Phase 03: User Profile Documents (users/{uid})
    // ==========================================
    match /users/{uid} {
      // 1. Read: A user can read ONLY their own document
      allow read: if request.auth != null && request.auth.uid == uid;

      // 2. Create: A user can create ONLY their own document
      //    The document ID must match the authenticated UID, and the payload's uid must also match
      allow create: if request.auth != null 
                    && request.auth.uid == uid 
                    && request.resource.data.uid == uid;

      // 3. Update: A user can update ONLY their own document
      //    Immutable checks: cannot change the uid, and cannot tamper with original createdAt
      allow update: if request.auth != null 
                    && request.auth.uid == uid 
                    && request.resource.data.uid == uid
                    && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt);

      // 4. Delete: Disallowed from client to protect user record integrity
      allow delete: if false;
    }

    // Default deny for all other collections and documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
